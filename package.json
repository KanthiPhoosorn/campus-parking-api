{
  "name": "campus-parking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Campus Parking Zones REST API \u2014 Cloudflare Workers + Hono + TypeScript + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute campus-parking --local --file=schema.sql",
    "db:remote": "wrangler d1 execute campus-parking --remote --file=schema.sql",
    "test": "node --test test/*.test.mjs",
    "test:remote": "BASE_URL=https://campus-parking-api.kanthiphs.workers.dev node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "tester": "python3 -m http.server 5500 --directory tester"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
