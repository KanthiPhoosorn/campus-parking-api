{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-parking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Browser origins allowed to call the API (comma-separated). Use "*" to allow any origin.
  // Add the frontend tester's origin here, e.g. "http://127.0.0.1:5500". A file:// page sends "null".
  "vars": {
    "CORS_ORIGINS": "http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:3000"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-parking",
      "database_id": "6ab6f6c9-e41b-463b-b053-3972f49d7989"
    }
  ]
}
